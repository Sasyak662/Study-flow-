<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="STUDYFLOW · TODAY" android:textColor="#E0E7FF" android:textSize="11sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_mins" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="0m" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Ready to focus" android:textColor="#E0E7FF" android:textSize="12sp" />
    <TextView android:id="@+id/w_start" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:background="@drawable/widget_btn"
        android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingTop="7dp" android:paddingBottom="7dp"
        android:text="▶  Start focus" android:textColor="#4338CA" android:textSize="13sp" android:textStyle="bold" />
</LinearLayout>
